{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whitelist-hide",
  "version": "0.1.0",
  "identifier": "io.github.sonnygalyeon.whitelisthide",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "whitelist-hide",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
