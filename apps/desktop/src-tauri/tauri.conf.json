{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "whitelist-hide",
  "version": "0.1.0",
  "identifier": "io.whitelisthide.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "whitelist-hide",
        "width": 960,
        "height": 720,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/whitelist-hide-helper"
    ],
    "resources": {
      "resources/whitelist-hide/generated/": "whitelist-hide/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
