{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "White Hide",
  "version": "1.0.0-rc.1",
  "identifier": "io.whitelisthide.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "White Hide",
        "width": 1120,
        "height": 860,
        "minWidth": 640,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/whitelist-hide-helper"
    ],
    "resources": {
      "resources/whitelist-hide/generated/": "whitelist-hide/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "1.0.0.1"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "nftables",
          "polkitd",
          "pkexec"
        ]
      },
      "rpm": {
        "depends": [
          "nftables",
          "polkit"
        ]
      }
    }
  }
}
